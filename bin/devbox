#!/usr/bin/env bash
# devbox - startet eine Sandbox (rootless Podman) mit dem aktuellen
# Verzeichnis unter /workspace und darin nvim, Rust und Claude Code.
#
# Aufbau der Befehle: Bloße Verben betreffen die Sandbox dieses Verzeichnisses
# (devbox stop, devbox status), alles andere nennt zuerst das Thema und dann die
# Aktion (devbox nvim sync, devbox claude auth, devbox firewall reload).
# Ohne Aktion startet ein Thema sein Programm (devbox nvim, devbox claude).
# Übersicht: devbox --help
#
# Konfiguration: ~/.config/devbox/config (Bash, setzt DEVBOX_*-Variablen),
# Umgebungsvariablen überschreiben die Datei. Siehe README.
set -euo pipefail

# --- Defaults --------------------------------------------------------------------
: "${DEVBOX_IMAGE:=localhost/devbox:latest}"
: "${DEVBOX_RUNTIME:=}"              # podman | docker (leer = automatisch)
: "${DEVBOX_MEMORY:=8g}"
: "${DEVBOX_PIDS:=4096}"
: "${DEVBOX_CPUS:=}"                 # z. B. 4
: "${DEVBOX_FIREWALL:=1}"            # 0 = Egress-Allowlist aus
: "${DEVBOX_ALLOW_HOST:=0}"          # 1 = Host-Gateway erreichbar
: "${DEVBOX_EXTRA_DOMAINS:=}"        # "host1 host2"
: "${DEVBOX_NVIM_CONFIG:=${XDG_CONFIG_HOME:-$HOME/.config}/nvim}"
: "${DEVBOX_PORTS:=}"                # "8080:8080 3000:3000"
: "${DEVBOX_MOUNTS:=}"               # zusätzliche -v Specs, leerzeichengetrennt
: "${DEVBOX_CLAUDE_ARGS:=--dangerously-skip-permissions}"
: "${DEVBOX_UID:=1000}"              # UID/GID des Users im Image (Build-Arg USER_UID)
: "${DEVBOX_GID:=1000}"
: "${DEVBOX_VOLUME_PREFIX:=devbox}"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/devbox/config"
# Datei darf nur setzen, was nicht schon per Umgebung gesetzt ist -> erst Env sichern
if [ -f "$CONFIG_FILE" ]; then
  _env_before="$(env | grep '^DEVBOX_' || true)"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  while IFS='=' read -r k v; do [ -n "$k" ] && export "$k=$v"; done <<<"$_env_before"
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

die() { echo "devbox: $*" >&2; exit 1; }
log() { echo "devbox: $*" >&2; }

usage() {
  cat <<'EOF'
devbox - Sandbox (rootless Podman) mit dem aktuellen Verzeichnis unter /workspace

Aufruf:  devbox [-C DIR] [BEFEHL [ARGS]]

Sandbox dieses Verzeichnisses
  devbox [shell]              zsh öffnen (Standard ohne Befehl)
  devbox root                 Root-Shell, z. B. für apt install (flüchtig)
  devbox run CMD...           beliebigen Befehl im Container ausführen
  devbox start                nur starten, ohne eine Shell zu öffnen
  devbox stop                 Container entfernen
  devbox restart              Container neu aufsetzen
  devbox status               Zustand und Ressourcen
  devbox logs                 Log des Entrypoints
  devbox list                 alle devbox-Container auf dem Host

Claude Code
  devbox claude [ARGS]        starten (mit DEVBOX_CLAUDE_ARGS)
  devbox claude auth          Login und Onboarding-Status vom Host ins Volume kopieren

Neovim
  devbox nvim [ARGS]          starten
  devbox nvim sync            Config vom Host neu in den Container kopieren

Firewall
  devbox firewall reload      Allowlist neu anwenden (DNS neu auflösen,
                              DEVBOX_EXTRA_DOMAINS vom Host übernehmen)

Image
  devbox image build [ARGS]   Image bauen (ARGS gehen an podman build)

Volumes
  devbox volume list          Volumes zeigen (Caches, Claude-Login, nvim-Plugins)
  devbox volume rm            diese Volumes löschen - der Claude-Login geht verloren

Devcontainer (VS Code)
  devbox devcontainer init    .devcontainer/devcontainer.json ins Projekt legen

Optionen
  -C DIR                      anderes Verzeichnis als $PWD als Workspace
  -h, --help                  diese Übersicht

Soll ein Argument an nvim/claude gehen und nicht als Unterbefehl gelten:
  devbox nvim -- sync

Konfiguration: ~/.config/devbox/config (Bash, setzt DEVBOX_*-Variablen),
Umgebungsvariablen überschreiben die Datei. Siehe README.
EOF
}

# --- Argumente ----------------------------------------------------------------------------
WORKSPACE="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    -C) shift; [ $# -gt 0 ] || die "-C braucht ein Verzeichnis"; WORKSPACE="$1"; shift ;;
    -h|--help|help) usage; exit 0 ;;
    *) break ;;
  esac
done
CMD="${1:-shell}"; [ $# -gt 0 ] && shift
WORKSPACE="$(readlink -f "$WORKSPACE")"
[ -d "$WORKSPACE" ] || die "kein Verzeichnis: $WORKSPACE"

# --- Runtime ---------------------------------------------------------------------------
if [ -z "$DEVBOX_RUNTIME" ]; then
  if command -v podman >/dev/null; then DEVBOX_RUNTIME=podman
  elif command -v docker >/dev/null; then DEVBOX_RUNTIME=docker
  else die "weder podman noch docker gefunden"; fi
fi
RT="$DEVBOX_RUNTIME"

# Containername: Basisname + kurzer Hash des Pfads
hash8="$(printf '%s' "$WORKSPACE" | sha256sum | cut -c1-8)"
base="$(printf '%s' "$(basename "$WORKSPACE")" | tr -c 'A-Za-z0-9_.-' '-' | cut -c1-30)"
NAME="devbox-${base}-${hash8}"

# --- Hilfsfunktionen ---------------------------------------------------------------------
running() { [ "$($RT inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || true)" = "true" ]; }
exists()  { $RT container exists "$NAME" 2>/dev/null; }

exec_in() {  # exec_in [-r|-rp] CMD...   (-r = als root, -rp = root mit allen Capabilities)
  local user="$DEVBOX_UID:$DEVBOX_GID" tty=() priv=()
  case "${1:-}" in
    -r)  user=0:0; shift ;;
    -rp) user=0:0; priv=(--privileged); shift ;;
  esac
  [ -t 0 ] && [ -t 1 ] && tty=(-it)
  # Kennt der Container den Terminaltyp nicht (fehlender terminfo-Eintrag), zeichnen
  # zsh/nvim jede Eingabe doppelt -> dann auf xterm-256color ausweichen
  $RT exec "${tty[@]}" "${priv[@]}" -u "$user" -w /workspace \
    -e "TERM=${TERM:-xterm-256color}" -e "COLORTERM=${COLORTERM:-truecolor}" \
    "$NAME" sh -c 'infocmp "$TERM" >/dev/null 2>&1 || export TERM=xterm-256color; exec "$@"' sh "$@"
}

start() {
  running && return 0
  if exists; then
    log "Container $NAME existiert, aber läuft nicht - wird entfernt"
    $RT rm -f "$NAME" >/dev/null
  fi
  $RT image exists "$DEVBOX_IMAGE" 2>/dev/null || die "Image $DEVBOX_IMAGE fehlt - erst 'devbox image build'"

  local args=(
    run -d --name "$NAME" --hostname devbox --stop-signal SIGKILL   # sleep als PID 1 ignoriert SIGTERM
    --label "devbox.workspace=$WORKSPACE"
    --user 0:0
    --cap-drop ALL
    --cap-add NET_ADMIN --cap-add NET_RAW        # Firewall im Entrypoint
    --cap-add SETUID --cap-add SETGID --cap-add SETPCAP --cap-add CHOWN   # setpriv/chown im Entrypoint
    --security-opt no-new-privileges
    --memory "$DEVBOX_MEMORY" --pids-limit "$DEVBOX_PIDS"
    -v "$WORKSPACE:/workspace:z"
    -v "${DEVBOX_VOLUME_PREFIX}-claude:/home/dev/.claude"
    -v "${DEVBOX_VOLUME_PREFIX}-nvim-data:/home/dev/.local/share/nvim"
    -v "${DEVBOX_VOLUME_PREFIX}-nvim-state:/home/dev/.local/state/nvim"
    -v "${DEVBOX_VOLUME_PREFIX}-cargo-registry:/home/dev/.cargo/registry"
    -v "${DEVBOX_VOLUME_PREFIX}-cargo-git:/home/dev/.cargo/git"
    -v "${DEVBOX_VOLUME_PREFIX}-history:/home/dev/.history"
    -e "DEVBOX_FIREWALL=$DEVBOX_FIREWALL"
    -e "DEVBOX_ALLOW_HOST=$DEVBOX_ALLOW_HOST"
    -e "DEVBOX_EXTRA_DOMAINS=$DEVBOX_EXTRA_DOMAINS"
    -e "TZ=${TZ:-Europe/Berlin}"
  )
  [ -n "$DEVBOX_CPUS" ] && args+=(--cpus "$DEVBOX_CPUS")
  if [ "$RT" = podman ]; then
    # rootless: Host-User <-> Container-User 1000 abbilden, damit Bind-Mounts passen
    args+=(--userns "keep-id:uid=$DEVBOX_UID,gid=$DEVBOX_GID")
  fi
  if [ -d "$DEVBOX_NVIM_CONFIG" ]; then
    args+=(-v "$DEVBOX_NVIM_CONFIG:/mnt/host/nvim:ro,z")
  else
    log "nvim-Config $DEVBOX_NVIM_CONFIG nicht gefunden - nvim ohne Config"
  fi
  # Git-Identität vom Host (keine Credentials)
  local gname gemail
  gname="$(git config --get user.name 2>/dev/null || true)"
  gemail="$(git config --get user.email 2>/dev/null || true)"
  [ -n "$gname" ]  && args+=(-e "GIT_AUTHOR_NAME=$gname"   -e "GIT_COMMITTER_NAME=$gname")
  [ -n "$gemail" ] && args+=(-e "GIT_AUTHOR_EMAIL=$gemail" -e "GIT_COMMITTER_EMAIL=$gemail")
  local p m
  for p in $DEVBOX_PORTS;  do args+=(-p "$p"); done
  for m in $DEVBOX_MOUNTS; do args+=(-v "$m"); done

  log "starte $NAME (Workspace: $WORKSPACE)"
  $RT "${args[@]}" "$DEVBOX_IMAGE" >/dev/null

  # auf Entrypoint warten (Firewall, Config-Sync)
  local i
  for i in $(seq 1 180); do
    if $RT exec "$NAME" test -f /run/devbox.ready 2>/dev/null; then return 0; fi
    if ! running; then
      $RT logs "$NAME" >&2 || true
      $RT rm -f "$NAME" >/dev/null 2>&1 || true
      die "Container ist beim Start abgebrochen (siehe Log oben). Tipp: DEVBOX_FIREWALL=0 devbox"
    fi
    sleep 0.5
  done
  $RT logs "$NAME" >&2 || true
  die "Entrypoint wurde nicht fertig"
}

# --- Aktionen der Themen-Befehle -------------------------------------------------------------
nvim_sync() {
  [ $# -eq 0 ] || die "nvim sync: keine weiteren Argumente (nvim -- sync startet nvim damit)"
  running || die "Container läuft nicht"
  exec_in -r /usr/local/bin/sync-nvim-config.sh
}

claude_auth() {
  [ $# -eq 0 ] || die "claude auth: keine weiteren Argumente"
  local src="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
  [ -f "$src" ] || die "kein $src auf dem Host (dort erst 'claude' und /login)"
  start
  $RT cp "$src" "$NAME:/home/dev/.claude/.credentials.json"
  # erst chmod, dann chown: Root im Container hat kein CAP_FOWNER und darf
  # die Datei nach der Übergabe an dev nicht mehr ändern
  exec_in -r chmod 600 /home/dev/.claude/.credentials.json
  exec_in -r chown "$DEVBOX_UID:$DEVBOX_GID" /home/dev/.claude/.credentials.json
  # Onboarding-Status mitnehmen: ohne hasCompletedOnboarding startet Claude den
  # Einrichtungsassistenten, und der verlangt den Login trotz gültiger Credentials
  local host_cfg fragment
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then host_cfg="$CLAUDE_CONFIG_DIR/.claude.json"; else host_cfg="$HOME/.claude.json"; fi
  if [ -f "$host_cfg" ] && command -v jq >/dev/null; then
    fragment="$(jq -c '{oauthAccount, hasCompletedOnboarding, lastOnboardingVersion, theme} | with_entries(select(.value != null))' "$host_cfg")"
    exec_in sh -c 'umask 077; f="$HOME/.claude/.claude.json"; [ -f "$f" ] || echo "{}" >"$f"
      jq --argjson add "$1" ". + \$add" "$f" >"$f.tmp" && mv "$f.tmp" "$f"' sh "$fragment"
    log "Claude-Login und Onboarding-Status in Volume ${DEVBOX_VOLUME_PREFIX}-claude übernommen"
  else
    log "Claude-Login übernommen; $host_cfg fehlt oder kein jq - Onboarding läuft im Container einmal durch"
  fi
}

firewall_reload() {  # nimmt DEVBOX_EXTRA_DOMAINS/DEVBOX_ALLOW_HOST vom Host, nicht die beim Start gesetzten
  [ $# -eq 0 ] || die "firewall reload: keine weiteren Argumente"
  running || die "Container läuft nicht"
  exec_in -r env "DEVBOX_EXTRA_DOMAINS=$DEVBOX_EXTRA_DOMAINS" "DEVBOX_ALLOW_HOST=$DEVBOX_ALLOW_HOST" \
    /usr/local/bin/init-firewall.sh
}

image_build() {
  [ -f "$REPO_DIR/Containerfile" ] || die "Containerfile nicht in $REPO_DIR"
  $RT build -t "$DEVBOX_IMAGE" \
    --build-arg "USER_UID=$DEVBOX_UID" --build-arg "USER_GID=$DEVBOX_GID" \
    --build-arg "TZ=${TZ:-Europe/Berlin}" "$@" "$REPO_DIR"
}

volume_list() {
  [ $# -eq 0 ] || die "volume list: keine weiteren Argumente"
  $RT volume ls --filter "name=${DEVBOX_VOLUME_PREFIX}-"
}

volume_rm() {
  [ $# -eq 0 ] || die "volume rm: keine weiteren Argumente"
  $RT volume ls -q | grep "^${DEVBOX_VOLUME_PREFIX}-" | xargs -r $RT volume rm
  log "Volumes entfernt"
}

devcontainer_init() {
  [ $# -eq 0 ] || die "devcontainer init: keine weiteren Argumente"
  local src="$REPO_DIR/devcontainer/devcontainer.json" dst="$WORKSPACE/.devcontainer/devcontainer.json"
  [ -f "$src" ] || die "Vorlage $src fehlt"
  [ -e "$dst" ] && die "$dst existiert bereits"
  mkdir -p "$(dirname "$dst")" && cp "$src" "$dst"
  log "angelegt: $dst (VS Code: dev.containers.dockerPath=podman)"
}

# Unterbefehl eines Themas fehlt oder ist unbekannt
bad_action() {  # bad_action THEMA ANGEGEBEN ERLAUBT...
  local topic="$1" given="$2"; shift 2
  [ -n "$given" ] && die "$topic $given: unbekannte Aktion (möglich: $*)"
  die "$topic: Aktion fehlt (möglich: $*)"
}

# Alte Namen, die es in der gruppierten Form nicht mehr gibt
renamed() { die "'$CMD' heißt jetzt: $*"; }

# --- Unterbefehle -----------------------------------------------------------------------------
case "$CMD" in
  # Sandbox dieses Verzeichnisses
  shell)   start; exec_in zsh -l ;;
  root)    start; exec_in -rp bash -l ;;
  run)     start; [ $# -gt 0 ] || die "run: Befehl fehlt"; exec_in "$@" ;;
  start)   start; log "läuft: $NAME ($WORKSPACE)" ;;
  stop)    exists && { $RT rm -f "$NAME" >/dev/null; log "$NAME gestoppt"; } || log "läuft nicht" ;;
  restart) exists && $RT rm -f "$NAME" >/dev/null; start; log "neu gestartet" ;;
  status)  if running; then echo "läuft: $NAME ($WORKSPACE)"; $RT stats --no-stream "$NAME"; else echo "gestoppt: $NAME"; fi ;;
  logs)    exists || die "kein Container $NAME"; $RT logs "$NAME" ;;
  list|ls) $RT ps -a --filter label=devbox.workspace --format 'table {{.Names}}\t{{.Status}}\t{{.Labels}}' \
             | sed 's/devbox.workspace=//' ;;

  # Themen: ohne Aktion startet das Programm, "--" erzwingt die Durchreiche
  claude)
    case "${1:-}" in
      auth) shift; claude_auth "$@" ;;
      --)   shift; start; exec_in claude $DEVBOX_CLAUDE_ARGS "$@" ;;
      *)    start; exec_in claude $DEVBOX_CLAUDE_ARGS "$@" ;;
    esac ;;
  nvim)
    case "${1:-}" in
      sync) shift; nvim_sync "$@" ;;
      --)   shift; start; exec_in nvim "$@" ;;
      *)    start; exec_in nvim "$@" ;;
    esac ;;
  firewall)
    case "${1:-}" in
      reload) shift; firewall_reload "$@" ;;
      *)      bad_action firewall "${1:-}" reload ;;
    esac ;;
  image)
    case "${1:-}" in
      build) shift; image_build "$@" ;;
      *)     bad_action image "${1:-}" build ;;
    esac ;;
  volume)
    case "${1:-}" in
      list) shift; volume_list "$@" ;;
      rm)   shift; volume_rm "$@" ;;
      *)    bad_action volume "${1:-}" list rm ;;
    esac ;;
  devcontainer)
    case "${1:-}" in
      init) shift; devcontainer_init "$@" ;;
      *)    bad_action devcontainer "${1:-}" init ;;
    esac ;;

  # frühere Namen
  sync)        renamed nvim sync ;;
  import-auth) renamed claude auth ;;
  build)       renamed image build ;;
  volumes)     renamed "volume list  bzw.  volume rm" ;;
  init)        renamed devcontainer init ;;

  *) die "unbekannter Befehl: $CMD (siehe devbox --help)" ;;
esac
